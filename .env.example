GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# strict is only enabled for explicitly supported models. Other models use JSON mode + Zod.
GROQ_OUTPUT_MODE=strict
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Vercel deployments use automatic OIDC. Local development: vercel env pull .env.local
VERCEL_OIDC_TOKEN=
# Only needed outside Vercel when not using OIDC:
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
REPRO_EXECUTION_ENABLED=false
# A random server-side salt for irreversible IP rate-limit identifiers.
REPRO_RATE_SALT=
